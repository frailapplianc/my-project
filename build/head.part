<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<meta name="color-scheme" content="light">
<title>Бухгалтерия</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ==========================================================================
   ДИЗАЙН-ТОКЕНЫ
   Весь внешний вид меняется здесь: цвета, шрифт, отступы, радиусы, скорость.
   ========================================================================== */
:root {
  /* Цвета: чёрно-белая палитра и один акцент */
  --color-bg: #ffffff;
  --color-ink: #0a0a0a;
  --color-ink-soft: #3d3d3d;
  --color-muted: #7a7a7a;
  --color-line: #ebebeb;
  --color-line-strong: #cfcfcf;
  --color-hover: #f7f7f7;
  --color-accent: #2f54ff;

  /* Шрифт */
  --font-ui: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --fs-xs: 0.75rem;
  --fs-sm: 0.8125rem;
  --fs-base: 0.875rem;
  --fs-md: 0.9375rem;
  --fs-lg: 1.25rem;
  --fs-xl: 2rem;
  --fs-display: clamp(1.75rem, 4.5vw, 2.75rem);
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;

  /* Отступы */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 16px;
  --space-4: 24px;
  --space-5: 40px;
  --space-6: 72px;

  /* Радиусы */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-bar: 2px;

  /* Размеры */
  --container: 1080px;
  --control-h: 36px;
  --row-h: 48px;
  --z-menu: 10;

  /* Анимации: 150–250 мс */
  --dur-fast: 150ms;
  --dur: 200ms;
  --dur-slow: 250ms;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
}

/* ---------- Базовое ---------- */
*, *::before, *::after { box-sizing: border-box; }
html {
  -webkit-text-size-adjust: 100%;
  -webkit-tap-highlight-color: transparent;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-ui);
  font-size: var(--fs-md);
  line-height: 1.5;
}
h1, h2, p, ul { margin: 0; padding: 0; }
ul { list-style: none; }
button, input, select { font: inherit; color: inherit; }
button { background: none; border: 0; padding: 0; cursor: pointer; touch-action: manipulation; text-align: inherit; }
:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
[hidden] { display: none !important; }
.sr-only {
  position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

.container {
  max-width: var(--container);
  margin: 0 auto;
  padding-left: max(var(--space-3), env(safe-area-inset-left));
  padding-right: max(var(--space-3), env(safe-area-inset-right));
  padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
}

/* ---------- Анимации появления ---------- */
@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
.reveal {
  opacity: 0;
  animation: rise var(--dur-slow) var(--ease-out) forwards;
  animation-delay: calc(var(--i, 0) * 50ms);
}
.swap { animation: fade var(--dur) var(--ease-out); }

/* ---------- Кнопки и поля ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: var(--control-h); padding: 0 var(--space-3);
  border: 1px solid var(--color-line-strong); border-radius: var(--radius-sm);
  background: var(--color-bg); color: var(--color-ink);
  font-size: var(--fs-sm); font-weight: var(--fw-medium);
  user-select: none; -webkit-user-select: none;
  transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg); }
.btn-link {
  font-size: var(--fs-sm); color: var(--color-muted); padding: var(--space-1) 0;
  transition: color var(--dur-fast) var(--ease-out);
}
.btn[disabled], .btn-link[disabled] { opacity: 0.4; pointer-events: none; }
@media (hover: hover) and (pointer: fine) {
  .btn:hover { background: var(--color-hover); }
  .btn-primary:hover { background: var(--color-ink-soft); }
  .btn-link:hover { color: var(--color-ink); }
}

.icon-btn {
  position: relative; display: inline-grid; place-items: center;
  width: 28px; height: 28px; border-radius: var(--radius-sm);
  color: var(--color-muted); font-size: 18px; line-height: 1;
  transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
}
.icon-btn::after { content: ""; position: absolute; inset: -8px; }
@media (hover: hover) and (pointer: fine) {
  .icon-btn:hover { color: var(--color-ink); background: var(--color-hover); }
}

.field {
  height: var(--control-h); min-width: 0; padding: 0;
  border: 0; border-bottom: 1px solid var(--color-line-strong); border-radius: 0;
  background: transparent;
  transition: border-color var(--dur-fast) var(--ease-out);
}
.field:focus { border-bottom-color: var(--color-accent); }
.field::placeholder { color: var(--color-muted); }

.select { position: relative; display: inline-flex; }
.select select {
  appearance: none; -webkit-appearance: none;
  height: var(--control-h); padding: 0 var(--space-4) 0 0;
  border: 0; border-bottom: 1px solid var(--color-line-strong); border-radius: 0;
  background: transparent; cursor: pointer;
}
.select::after {
  content: ""; position: absolute; right: 4px; top: 50%;
  width: 5px; height: 5px; pointer-events: none;
  border-right: 1.5px solid var(--color-muted); border-bottom: 1.5px solid var(--color-muted);
  transform: translateY(-70%) rotate(45deg);
}
.select-block { display: flex; }
.select-block select { width: 100%; }

/* ---------- Шапка ---------- */
.topbar { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: var(--space-3); }
.logo { display: flex; align-items: center; gap: var(--space-3); min-height: 40px; }
.logo img { display: block; max-height: 40px; max-width: 200px; width: auto; }
.logo-slot { display: inline-flex; align-items: center; cursor: pointer; font-size: var(--fs-sm); color: var(--color-muted); }
.logo-slot span { border-bottom: 1px solid var(--color-line-strong); padding-bottom: 1px; }

.switch {
  display: inline-flex; align-items: center; gap: var(--space-2);
  min-height: var(--control-h); font-size: var(--fs-sm); color: var(--color-ink-soft);
  user-select: none; -webkit-user-select: none;
}
.switch-track {
  position: relative; width: 28px; height: 16px; border-radius: 999px;
  background: var(--color-line-strong);
  transition: background-color var(--dur) var(--ease-out);
}
.switch-track::after {
  content: ""; position: absolute; top: 2px; left: 2px;
  width: 12px; height: 12px; border-radius: 50%; background: var(--color-bg);
  transition: transform var(--dur) var(--ease-out);
}
.switch[aria-checked="true"] .switch-track { background: var(--color-ink); }
.switch[aria-checked="true"] .switch-track::after { transform: translateX(12px); }

/* ---------- Заголовок ---------- */
.intro { margin-top: var(--space-4); }
.intro h1 {
  font-size: var(--fs-xl); font-weight: var(--fw-semibold);
  letter-spacing: -0.02em; line-height: 1.15; text-wrap: balance;
}
.intro p { margin-top: var(--space-2); color: var(--color-muted); text-wrap: pretty; }

/* Редактируемые подписи */
.is-editable { border-radius: var(--radius-sm); transition: background-color var(--dur-fast) var(--ease-out); }
.is-editable:focus { outline: 1px solid var(--color-accent); outline-offset: 2px; }
@media (hover: hover) and (pointer: fine) {
  .is-editable:hover { background: var(--color-hover); }
}

/* ---------- Вкладки ---------- */
.tabs-bar {
  display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-3);
  margin-top: var(--space-5); border-bottom: 1px solid var(--color-line);
}
.tabs { display: flex; gap: var(--space-4); overflow-x: auto; scrollbar-width: none; }
.tabs::-webkit-scrollbar { display: none; }
.tab {
  position: relative; padding: var(--space-2) 0 var(--space-3);
  color: var(--color-muted); font-weight: var(--fw-medium); white-space: nowrap;
  transition: color var(--dur-fast) var(--ease-out);
}
.tab::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
  background: var(--color-accent); transform: scaleX(0); transform-origin: left;
  transition: transform var(--dur) var(--ease-out);
}
.tab[aria-selected="true"] { color: var(--color-ink); }
.tab[aria-selected="true"]::after { transform: scaleX(1); }
@media (hover: hover) and (pointer: fine) { .tab:hover { color: var(--color-ink); } }
.tab-add { padding-bottom: var(--space-3); white-space: nowrap; }
.tab-stats { margin-left: var(--space-3); }
.block-first { margin-top: var(--space-5); }
.tab-tools { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-3); }

/* ---------- Карточки показателей ---------- */
.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin-top: var(--space-5); }
.card { min-width: 0; border-top: 1px solid var(--color-ink); padding-top: var(--space-3); }
.card-label { font-size: var(--fs-sm); color: var(--color-muted); }
.card-value {
  margin-top: var(--space-2);
  font-size: var(--fs-display); font-weight: var(--fw-medium);
  letter-spacing: -0.025em; line-height: 1.1;
  font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
}

/* ---------- Блоки ---------- */
.block { margin-top: var(--space-6); }
.block-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.block-head h2, .analytics h2 { font-size: var(--fs-lg); font-weight: var(--fw-semibold); letter-spacing: -0.01em; }

.menu { position: relative; }
.menu > summary { list-style: none; }
.menu > summary::-webkit-details-marker { display: none; }
.menu-list {
  position: absolute; right: 0; top: calc(100% + var(--space-1)); z-index: var(--z-menu);
  min-width: 260px; padding: var(--space-1);
  background: var(--color-bg); border: 1px solid var(--color-line); border-radius: var(--radius-md);
  animation: fade var(--dur-fast) var(--ease-out);
}
.menu-item { display: block; width: 100%; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); font-size: var(--fs-sm); }
@media (hover: hover) and (pointer: fine) { .menu-item:hover { background: var(--color-hover); } }

.toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-4); margin: var(--space-3) 0 var(--space-4); }
.field-search { flex: 1 1 200px; max-width: 320px; }
.range { display: flex; align-items: flex-end; gap: var(--space-2); font-size: var(--fs-sm); color: var(--color-muted); }

/* ---------- Таблица ---------- */
.table-wrap { overflow-x: auto; margin: 0 calc(var(--space-3) * -1); -webkit-overflow-scrolling: touch; }
table { width: 100%; min-width: 680px; border-collapse: collapse; font-size: var(--fs-base); font-variant-numeric: tabular-nums; }
th {
  padding: 0 var(--space-3) var(--space-2); text-align: left; white-space: nowrap;
  font-size: var(--fs-sm); font-weight: var(--fw-medium); color: var(--color-muted);
  border-bottom: 1px solid var(--color-line-strong);
}
td { height: var(--row-h); padding: 0 var(--space-3); border-bottom: 1px solid var(--color-line); transition: background-color var(--dur-fast) var(--ease-out); }
.is-right { text-align: right; }
.th-btn, .th-inner { display: inline-flex; align-items: center; gap: var(--space-1); color: inherit; }
th.is-right .th-btn, th.is-right .th-inner { flex-direction: row-reverse; }
.th-btn { transition: color var(--dur-fast) var(--ease-out); }
@media (hover: hover) and (pointer: fine) {
  .th-btn:hover { color: var(--color-ink); }
  tbody tr:hover td { background: var(--color-hover); }
}
tbody tr:focus-within td { background: var(--color-hover); }

.sort-ind { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid transparent; transition: transform var(--dur-fast) var(--ease-out); }
.sort-ind[data-dir="asc"] { border-top-color: var(--color-ink); transform: rotate(180deg); }
.sort-ind[data-dir="desc"] { border-top-color: var(--color-ink); }
.col-tool, .cell-actions { width: 44px; padding-left: 0; padding-right: var(--space-1); text-align: right; }

.status { display: inline-flex; align-items: center; gap: var(--space-2); white-space: nowrap; }
.dot { flex: none; width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--color-ink); background: var(--color-ink); }
.dot[data-tone="hollow"] { background: transparent; }
.dot[data-tone="faint"] { background: var(--color-line-strong); border-color: var(--color-line-strong); }

/* Редактор: ячейки-поля */
.is-editor td { padding: 0 var(--space-1); }
.is-editor td.cell-actions { padding-right: var(--space-1); }
.cell-input {
  width: 100%; height: calc(var(--row-h) - var(--space-2)); padding: 0 12px;
  border: 0; border-radius: var(--radius-sm); background: transparent;
  text-align: inherit; font-variant-numeric: inherit;
  transition: background-color var(--dur-fast) var(--ease-out);
}
.cell-input:focus-visible { outline: 1px solid var(--color-accent); outline-offset: -1px; background: var(--color-bg); }
@media (hover: hover) and (pointer: fine) { .cell-input:hover { background: var(--color-line); } }
select.cell-input { appearance: none; -webkit-appearance: none; cursor: pointer; padding-left: var(--space-2); }
.status-edit { display: flex; align-items: center; padding-left: 12px; }
.status-edit .cell-input { flex: 1; }

.empty { padding: var(--space-5) 0 var(--space-3); color: var(--color-muted); }
.table-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-top: var(--space-3); font-size: var(--fs-sm); color: var(--color-muted); }

/* ---------- Аналитика ---------- */
.analytics-grid { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-5); }
.analytics-grid > div { min-width: 0; }
.legend { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-2) 0 var(--space-3); font-size: var(--fs-sm); color: var(--color-muted); }
.legend span { display: inline-flex; align-items: center; gap: var(--space-2); }
.swatch { width: 8px; height: 8px; border-radius: var(--radius-bar); }
.swatch-income { background: var(--color-ink); }
.swatch-expense { background: var(--color-line-strong); }
#chart svg { display: block; overflow: visible; }
.grid-line { stroke: var(--color-line); stroke-width: 1; }
.axis { fill: var(--color-muted); font-family: var(--font-ui); font-size: var(--fs-xs); }
.bar { rx: var(--radius-bar); transition: fill var(--dur-fast) var(--ease-out); }
.bar-income { fill: var(--color-ink); }
.bar-expense { fill: var(--color-line-strong); }
@media (hover: hover) and (pointer: fine) { .bar:hover { fill: var(--color-accent); } }

.breakdown-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.seg { display: inline-flex; gap: var(--space-3); }
.seg button { font-size: var(--fs-sm); color: var(--color-muted); padding: var(--space-1) 0; border-bottom: 1px solid transparent; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
.seg button[aria-pressed="true"] { color: var(--color-ink); border-bottom-color: var(--color-ink); }
#breakdown { margin-top: var(--space-3); display: grid; gap: var(--space-3); }
.share-row { display: flex; justify-content: space-between; gap: var(--space-3); font-size: var(--fs-base); }
.share-name { min-width: 0; overflow-wrap: anywhere; }
.share-sum { white-space: nowrap; font-variant-numeric: tabular-nums; }
.share-pct { margin-left: var(--space-2); color: var(--color-muted); }
.share-bar { height: 2px; margin-top: 6px; background: var(--color-line); }
.share-fill { height: 100%; background: var(--color-ink); }

/* ---------- Диалог ---------- */
dialog {
  width: min(420px, calc(100vw - 32px)); padding: 0;
  border: 1px solid var(--color-line); border-radius: var(--radius-md);
  background: var(--color-bg); color: var(--color-ink);
}
dialog[open] { animation: pop var(--dur) var(--ease-out); }
dialog::backdrop { background: color-mix(in srgb, var(--color-bg) 70%, transparent); }
@keyframes pop { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
.dialog-body { padding: var(--space-4); display: grid; gap: var(--space-3); }
.dialog-body h2 { font-size: var(--fs-lg); font-weight: var(--fw-semibold); letter-spacing: -0.01em; }
.dialog-text { color: var(--color-muted); text-wrap: pretty; }
.dialog-field { display: grid; gap: var(--space-1); }
.dialog-field label { font-size: var(--fs-sm); color: var(--color-muted); }
.dialog-field .field { width: 100%; }
.dialog-actions { display: flex; justify-content: flex-end; gap: var(--space-2); margin-top: var(--space-2); }

/* ---------- Адаптив ---------- */
@media (max-width: 800px) {
  .analytics-grid { grid-template-columns: 1fr; gap: var(--space-5); }
}
@media (max-width: 640px) {
  .cards { grid-template-columns: 1fr; gap: var(--space-4); }
  .block { margin-top: var(--space-5); }
  .topbar { min-height: 60px; }
  .menu-list { min-width: 220px; }
}
@media (pointer: coarse) {
  input, select, .cell-input { font-size: 16px; }
  .btn, .field, .select select { min-height: 44px; }
  .tab { padding-top: var(--space-3); }
}

/* ---------- Уменьшенное движение: остаётся только плавное появление ---------- */
@media (prefers-reduced-motion: reduce) {
  .reveal { animation-name: fade; }
  dialog[open] { animation-name: fade; }
  .btn:active { transform: none; }
  .switch-track::after, .tab::after, .sort-ind { transition: none; }
}
</style>
<script>(function(){var t;try{t=localStorage.getItem('theme')}catch(e){}
if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';
document.documentElement.dataset.theme=t;})();</script>
</head>
